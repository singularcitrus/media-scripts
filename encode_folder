#!/usr/bin/env bash

# Usage: ./encode_folder.sh -p "Preset Name" -i "/path/to/input" -o "/path/to/output" [-e mkv] [-g] [-f]

set -euo pipefail

# ── Colours & symbols ─────────────────────────────────────────────────────────
RESET="\033[0m"
BOLD="\033[1m"
DIM="\033[2m"
RED="\033[0;31m"
GREEN="\033[0;32m"
YELLOW="\033[0;33m"
BLUE="\033[0;34m"
CYAN="\033[0;36m"
WHITE="\033[1;37m"

SYM_OK="✔"
SYM_FAIL="✘"
SYM_SKIP="⊘"
SYM_ARROW="➜"
SYM_FILM="🎬"
SYM_FOLDER="📁"
SYM_LOG="📋"
SYM_INFO="ℹ️"

# ── Helpers ───────────────────────────────────────────────────────────────────
divider()    { echo -e "${DIM}$(printf '─%.0s' {1..54})${RESET}"; }
separator()  { echo -e "${DIM}$(printf '═%.0s' {1..54})${RESET}"; }

log_info()   { echo -e "  ${BLUE}${BOLD}${SYM_INFO}${RESET}  $*"; }
log_ok()     { echo -e "  ${GREEN}${BOLD}${SYM_OK}${RESET}   $*"; }
log_skip()   { echo -e "  ${YELLOW}${BOLD}${SYM_SKIP}${RESET}   $*"; }
log_fail()   { echo -e "  ${RED}${BOLD}${SYM_FAIL}${RESET}   $*" >&2; }
log_dim()    { echo -e "  ${DIM}${SYM_ARROW}  $*${RESET}"; }

# Prints HandBrake progress lines in-place on a single terminal line.
# Everything is also tee'd to the log file.
show_progress() {
  local log_file="$1"
  local output_file="$2"
  local input_file="$3"

  local input_bytes=0
  if [[ -f "$input_file" ]]; then
    input_bytes=$(stat -c%s "$input_file" 2>/dev/null || echo 0)
  fi

  tr '\r' '\n' | \
  grep --line-buffered -E "^[[:space:]]*(Encoding: task|Muxing:)" | \
  tee -a "$log_file" | \
  while IFS= read -r line; do
    line="${line#"${line%%[![:space:]]*}"}"

    if [[ "$line" =~ (Encoding:\ task[^\)]*\)) ]]; then
      line="${BASH_REMATCH[1]}"
    elif [[ "$line" =~ (Muxing:.*) ]]; then
      line="${BASH_REMATCH[1]}"
    else
      continue
    fi

    local cols; cols=$(tput cols || echo 80)
    local max=$(( cols - 4 ))

    local bytes
    bytes=$(stat -c%s "$output_file" 2>/dev/null || echo 0)

    local size=" | File Size: $(numfmt --to=iec --suffix=B "$bytes")"
    local projected=""
    local compression=""

    if [[ "$line" =~ ([0-9]+(\.[0-9]+)?)\ % ]]; then
      local percent="${BASH_REMATCH[1]}"

      if awk "BEGIN { exit !($percent > 0) }"; then
        local projected_bytes
        projected_bytes=$(awk "BEGIN { printf \"%.0f\", $bytes / ($percent / 100) }")

        projected=" | Projected: $(numfmt --to=iec --suffix=B "$projected_bytes")"

        if [[ "$input_bytes" -gt 0 && "$projected_bytes" -gt 0 ]]; then
          local ratio
          ratio=$(awk "BEGIN { printf \"%.1f\", ($projected_bytes / $input_bytes) * 100 }")

          local saved
          saved=$(awk "BEGIN { printf \"%.1f\", (1 - ($projected_bytes / $input_bytes)) * 100 }")

          compression=" | Est: ${ratio}% of original, save ${saved}%"
        fi
      fi
    fi

    local extras="${size}${projected}${compression}"
    local line_max=$(( max - ${#extras} - 1 ))
    [[ $line_max -lt 20 ]] && line_max=20

    [[ ${#line} -gt $line_max ]] && line="${line:0:$line_max}…"

    local display="${line}${extras}"

    printf "\r  ${CYAN}%-${max}s${RESET}" "$display"
  done

  printf "\r\033[K"
}

# Returns the first file in a directory whose base name (sans extension)
# matches the given stem, or an empty string if none found.
find_existing_output() {
  local dir="$1" stem="$2"

  [[ -d "$dir" ]] || {
    echo ""
    return
  }

  while IFS= read -r -d '' f; do
    local base; base=$(basename "$f")
    if [[ "${base%.*}" == "$stem" ]]; then
      echo "$f"
      return
    fi
  done < <(find "$dir" -maxdepth 1 -type f -print0)

  echo ""
}

# Returns path relative to base directory.
relative_path() {
  local base="$1"
  local path="$2"

  realpath --relative-to="$base" "$path"
}

# ── Argument parsing ──────────────────────────────────────────────────────────
usage() {
  separator
  echo -e "  ${BOLD}${WHITE}encode_folder.sh${RESET} — Batch encode media files with HandBrakeCLI"
  separator
  echo -e "  ${BOLD}Usage:${RESET}"
  echo -e "    $0 ${CYAN}-p${RESET} <preset> ${CYAN}-i${RESET} <input_dir> ${CYAN}-o${RESET} <output_dir> [${CYAN}-e${RESET} <ext>] [${CYAN}-g${RESET}] [${CYAN}-f${RESET}]"
  echo
  echo -e "  ${BOLD}Options:${RESET}"
  echo -e "    ${CYAN}-p${RESET}  HandBrake preset name   (e.g. \"Fast 1080p30\")"
  echo -e "    ${CYAN}-i${RESET}  Input media folder      (e.g. /media/Series or /media/Movies)"
  echo -e "    ${CYAN}-o${RESET}  Output media folder     (e.g. /media/Encoded)"
  echo -e "    ${CYAN}-e${RESET}  Output file extension   (default: mkv)"
  echo -e "    ${CYAN}-g${RESET}  Pass --preset-import-gui to HandBrakeCLI"
  echo -e "    ${CYAN}-f${RESET}  Force re-encode even if the output file already exists"
  separator
  exit 1
}

PRESET=""
INPUT_DIR=""
OUTPUT_DIR=""
OUTPUT_EXT="mkv"
IMPORT_GUI=false
FORCE=false

while getopts ":p:i:o:e:gf" opt; do
  case $opt in
    p) PRESET="$OPTARG" ;;
    i) INPUT_DIR="$OPTARG" ;;
    o) OUTPUT_DIR="$OPTARG" ;;
    e) OUTPUT_EXT="$OPTARG" ;;
    g) IMPORT_GUI=true ;;
    f) FORCE=true ;;
    *) usage ;;
  esac
done

[[ -z "$PRESET" || -z "$INPUT_DIR" || -z "$OUTPUT_DIR" ]] && usage

# Strip trailing slashes so relative paths stay sane.
INPUT_DIR="${INPUT_DIR%/}"
OUTPUT_DIR="${OUTPUT_DIR%/}"
OUTPUT_EXT="${OUTPUT_EXT#.}"

# ── Sanity checks ─────────────────────────────────────────────────────────────
if ! command -v HandBrakeCLI &>/dev/null; then
  echo -e "\n  ${RED}${BOLD}Error:${RESET} HandBrakeCLI not found in PATH.\n" >&2
  exit 1
fi

if ! command -v realpath &>/dev/null; then
  echo -e "\n  ${RED}${BOLD}Error:${RESET} realpath not found in PATH.\n" >&2
  exit 1
fi

if [[ ! -d "$INPUT_DIR" ]]; then
  echo -e "\n  ${RED}${BOLD}Error:${RESET} Input directory not found: ${WHITE}$INPUT_DIR${RESET}\n" >&2
  exit 1
fi

mkdir -p "$OUTPUT_DIR"

# ── Build optional HandBrake flags ────────────────────────────────────────────
EXTRA_FLAGS=()
$IMPORT_GUI && EXTRA_FLAGS+=("--preset-import-gui")

# ── Header ────────────────────────────────────────────────────────────────────
echo
separator
echo -e "  ${BOLD}${WHITE}${SYM_FILM}  Encode Folder${RESET}"
separator
log_info "${BOLD}Preset   :${RESET} ${CYAN}${PRESET}${RESET}"
log_info "${BOLD}Input    :${RESET} ${WHITE}${INPUT_DIR}${RESET}"
log_info "${BOLD}Output   :${RESET} ${WHITE}${OUTPUT_DIR}${RESET}"
log_info "${BOLD}Ext      :${RESET} ${YELLOW}${OUTPUT_EXT}${RESET}"
$IMPORT_GUI && log_info "${BOLD}Flags    :${RESET} ${YELLOW}--preset-import-gui${RESET}"
$FORCE      && log_info "${BOLD}Force    :${RESET} ${YELLOW}existing output files will be overwritten${RESET}"
separator
echo

# ── Counters ──────────────────────────────────────────────────────────────────
total=0
success=0
failed=0
skipped=0
failed_files=()
CURRENT_OUT_FILE=""
current_group=""

cleanup_interrupt() {
  printf "\r\033[K\n" >&2

  log_fail "Interrupted. Stopping current encode and exiting."

  if [[ -n "${CURRENT_OUT_FILE:-}" && -f "$CURRENT_OUT_FILE" ]]; then
    log_dim "Removing partial output: ${DIM}${CURRENT_OUT_FILE}${RESET}"
    rm -f "$CURRENT_OUT_FILE"
  fi

  trap - INT TERM
  kill 0 2>/dev/null || true
  exit 130
}

trap cleanup_interrupt INT TERM

# ── Main loop ─────────────────────────────────────────────────────────────────
while IFS= read -r -d '' source_file; do
  relative_file=$(relative_path "$INPUT_DIR" "$source_file")
  relative_dir=$(dirname "$relative_file")
  filename=$(basename "$source_file")
  name_no_ext="${filename%.*}"

  if [[ "$relative_dir" == "." ]]; then
    out_dir="$OUTPUT_DIR"
    group_name="Root"
    out_file="${OUTPUT_DIR}/${name_no_ext}.${OUTPUT_EXT}"
  else
    out_dir="${OUTPUT_DIR}/${relative_dir}"
    group_name="$relative_dir"
    out_file="${out_dir}/${name_no_ext}.${OUTPUT_EXT}"
  fi

  if [[ "$group_name" != "$current_group" ]]; then
    [[ -n "$current_group" ]] && echo
    current_group="$group_name"

    echo -e "  ${BOLD}${WHITE}${SYM_FOLDER}  ${group_name}${RESET}"
    divider

    if [[ ! -d "$out_dir" ]]; then
      log_info "Creating output directory: ${DIM}${out_dir}${RESET}"
    fi
  fi

  mkdir -p "$out_dir"

  ((total++)) || true

  # Check for any existing file with the same stem in the target directory,
  # regardless of extension.
  existing_file=$(find_existing_output "$out_dir" "$name_no_ext")

  if [[ -n "$existing_file" ]] && ! $FORCE; then
    log_skip "${YELLOW}${relative_file}${RESET}"
    log_dim "output already exists as ${DIM}${existing_file}${RESET}, skipping"
    ((skipped++)) || true
    echo
    continue
  fi

  echo -e "  ${BOLD}${WHITE}[${total}]${RESET} ${WHITE}${relative_file}${RESET}"

  if [[ -n "$existing_file" ]] && $FORCE; then
    log_dim "${DIM}${out_file}${RESET} ${YELLOW}(overwriting $(basename "$existing_file"))${RESET}"
  else
    log_dim "${DIM}${out_file}${RESET}"
  fi
  echo

  CURRENT_OUT_FILE="$out_file"

  # Pipe full output to log; display only Encoding/Muxing progress in terminal.
  if HandBrakeCLI \
      "${EXTRA_FLAGS[@]}" \
      --preset "$PRESET" \
      --input  "$source_file" \
      --output "$out_file" \
      < /dev/null \
      2>&1 | show_progress "${OUTPUT_DIR}/encode.log" "$out_file" "$source_file"; then
    printf "\r\033[K\n"

    original_bytes=$(stat -c%s "$source_file")
    final_bytes=$(stat -c%s "$out_file")
    saved_bytes=$(( original_bytes - final_bytes ))
    saved_pct=$(awk "BEGIN { printf \"%.1f\", (1 - ($final_bytes / $original_bytes)) * 100 }")

    log_info "Original: $(numfmt --to=iec --suffix=B "$original_bytes")  →  Final: $(numfmt --to=iec --suffix=B "$final_bytes")"
    log_info "Space saved: $(numfmt --to=iec --suffix=B "$saved_bytes") (${saved_pct}%)"

    log_ok "${GREEN}Encoded successfully${RESET}"

    ((success++)) || true
  else
    log_fail "${RED}Encoding failed${RESET} — ${DIM}see encode.log for details${RESET}"
    ((failed++)) || true
    failed_files+=("$source_file")
    [[ -f "$out_file" ]] && rm -f "$out_file"
  fi

  CURRENT_OUT_FILE=""

  echo

done < <(find "$INPUT_DIR" -type f \( \
    -iname "*.mkv" -o -iname "*.mp4" -o -iname "*.avi" \
    -o -iname "*.m4v" -o -iname "*.mov" -o -iname "*.ts"  \
    -o -iname "*.wmv" \) -print0 | sort -z)

# ── Summary ───────────────────────────────────────────────────────────────────
echo
separator
echo -e "  ${BOLD}${WHITE}Summary${RESET}"
separator
echo -e "  ${DIM}Total   ${RESET}  ${WHITE}${BOLD}${total}${RESET}"
echo -e "  ${GREEN}${SYM_OK} Done   ${RESET}  ${GREEN}${BOLD}${success}${RESET}"
echo -e "  ${YELLOW}${SYM_SKIP} Skipped${RESET}  ${YELLOW}${BOLD}${skipped}${RESET}"
echo -e "  ${RED}${SYM_FAIL} Failed ${RESET}  ${RED}${BOLD}${failed}${RESET}"

if [[ ${#failed_files[@]} -gt 0 ]]; then
  echo
  echo -e "  ${RED}${BOLD}Failed files:${RESET}"
  for f in "${failed_files[@]}"; do
    echo -e "    ${DIM}${SYM_ARROW}${RESET}  ${RED}${f}${RESET}"
  done
fi

separator
echo -e "  ${SYM_LOG}  Log: ${DIM}${OUTPUT_DIR}/encode.log${RESET}"
separator
echo
